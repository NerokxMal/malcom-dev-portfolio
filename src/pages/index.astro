---
import Layout from "../layouts/Layout.astro";
import BootScreen from "../components/BootScreen.astro";
import Navbar from "../components/Navbar.astro";
import GitHubBadge from "../components/GitHubBadge.astro";
---

<Layout title="Malcom Camilo García Ortegón — Backend Developer">
  <!-- Pantalla de carga tipo terminal retro -->
  <BootScreen />

  <!-- Barra de navegación fija con indicador -->
  <Navbar />

  <main class="max-w-4xl mx-auto px-6 pt-28 pb-20 space-y-28">
    <!-- Hero Section -->
    <section id="hero" class="reveal-item space-y-6 pt-6">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FF8A4C]/10 border border-[#FF8A4C]/35 text-[#FF8A4C] text-xs font-mono font-medium"
      >
        <span class="w-2 h-2 rounded-full bg-[#FF8A4C] animate-pulse"></span>
        Disponible para proyectos y oportunidades
      </div>

      <h1
        class="text-4xl sm:text-6xl font-bold tracking-tight font-display text-white"
      >
        Malcom Camilo <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#FF8A4C] to-[#FFA372]"
          >García Ortegón</span
        >
      </h1>

      <h2 class="text-xl sm:text-2xl text-[#FF8A4C] font-semibold font-mono">
        Backend Developer — Java & Spring Boot
      </h2>

      <p class="text-slate-300 text-lg sm:text-xl max-w-2xl leading-relaxed">
        Tecnólogo ADSI enfocado en construir soluciones backend escalables y
        robustas. Apasionado por el código limpio y el aprendizaje constante.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="https://github.com/NerokxMal"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#FF8A4C] text-slate-950 px-6 py-3 rounded-xl font-semibold hover:bg-[#FFA372] transition-all shadow-lg shadow-[#FF8A4C]/20 flex items-center gap-2 group"
        >
          <span>Ver GitHub</span>
          <svg
            class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
          >
        </a>
        <a
          href="/cv.pdf"
          class="border border-[#243343] bg-[#17202A] text-slate-200 px-6 py-3 rounded-xl font-medium hover:border-[#FF8A4C]/60 hover:text-[#FF8A4C] transition-all flex items-center gap-2"
        >
          <span>Descargar CV</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path></svg
          >
        </a>
      </div>
    </section>

    <!-- Sobre Mí -->
    <section id="about" class="reveal-item space-y-6">
      <div class="flex items-center gap-3">
        <h3 class="text-2xl font-bold font-display text-white">Sobre mí</h3>
        <div class="h-px bg-[#243343] flex-grow"></div>
      </div>

      <div
        class="bg-[#17202A] border border-[#243343] p-6 sm:p-8 rounded-2xl shadow-xl space-y-4"
      >
        <p class="text-slate-300 leading-relaxed text-base sm:text-lg">
          Tecnólogo ADSI (SENA) con un fuerte enfoque en Java y el ecosistema
          Spring Boot. Me especializo en el desarrollo backend, estructurando
          arquitecturas limpias y APIs seguras.
        </p>
        <p class="text-slate-400 leading-relaxed">
          Mantengo un aprendizaje autónomo constante, experimentando con
          patrones de diseño, microservicios y bases de datos. Actualmente estoy
          dedicado a construir proyectos reales que desafíen mis habilidades y
          aporten valor real.
        </p>
      </div>
    </section>

    <!-- Proyectos -->
    <section id="projects" class="reveal-item space-y-8">
      <div class="flex items-center gap-3">
        <h3 class="text-2xl font-bold font-display text-white">
          Proyectos Destacados
        </h3>
        <div class="h-px bg-[#243343] flex-grow"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Sm4rt Stock -->
        <div
          class="project-card bg-[#17202A] border border-[#243343] p-6 rounded-2xl flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div
                class="w-10 h-10 rounded-xl bg-[#FF8A4C]/10 border border-[#FF8A4C]/30 flex items-center justify-center text-[#FF8A4C]"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                  ></path></svg
                >
              </div>
              <span
                class="text-xs font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                >Activo</span
              >
            </div>
            <h4 class="text-xl font-bold font-display text-white">
              sm4rt-stock
            </h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              Sistema de gestión de inventario robusto y eficiente con control
              de stock y trazabilidad.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2">
              <span
                class="text-xs font-mono bg-[#12181F] text-slate-300 px-2.5 py-1 rounded-md border border-[#243343]"
                >Java</span
              >
              <span
                class="text-xs font-mono bg-[#12181F] text-slate-300 px-2.5 py-1 rounded-md border border-[#243343]"
                >Spring Boot 3</span
              >
              <span
                class="text-xs font-mono bg-[#12181F] text-slate-300 px-2.5 py-1 rounded-md border border-[#243343]"
                >Astro</span
              >
            </div>
          </div>
          <div class="pt-6 mt-6 border-t border-[#243343]">
            <a
              href="https://github.com/NerokxMal/sm4rt-stock"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#FF8A4C] text-sm font-semibold hover:text-[#FFA372] flex items-center gap-1.5 group"
            >
              <span>Ver repositorio</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
              >
            </a>
          </div>
        </div>

        <!-- Sistema de Reservas -->
        <div
          class="project-card bg-[#17202A]/60 border border-[#243343]/60 p-6 rounded-2xl flex flex-col justify-between opacity-80"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div
                class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-400"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path></svg
                >
              </div>
              <span
                class="text-xs font-mono px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20"
                >Próximamente</span
              >
            </div>
            <h4 class="text-xl font-bold font-display text-white">
              Sistema de Reservas
            </h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              Próximo desarrollo backend enfocado en concurrencia, transacciones
              seguras y gestión de disponibilidad.
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-[#243343]">
            <span class="text-slate-500 text-sm font-medium italic"
              >En desarrollo...</span
            >
          </div>
        </div>

        <!-- Bot Twitch -->
        <div
          class="project-card bg-[#17202A] border border-[#243343] p-6 rounded-2xl flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-start">
              <div
                class="w-10 h-10 rounded-xl bg-[#FF8A4C]/10 border border-[#FF8A4C]/30 flex items-center justify-center text-[#FF8A4C]"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z"
                  ></path></svg
                >
              </div>
              <span
                class="text-xs font-mono px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20"
                >Con Dashboard</span
              >
            </div>
            <h4 class="text-xl font-bold font-display text-white">
              Bot !habla para Twitch
            </h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              Bot interactivo en tiempo real con Node.js, WebSockets y
              Text-To-Speech. Cuenta con su propio dashboard de control.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2">
              <span
                class="text-xs font-mono bg-[#12181F] text-slate-300 px-2.5 py-1 rounded-md border border-[#243343]"
                >Node.js</span
              >
              <span
                class="text-xs font-mono bg-[#12181F] text-slate-300 px-2.5 py-1 rounded-md border border-[#243343]"
                >WebSockets</span
              >
              <span
                class="text-xs font-mono bg-[#12181F] text-slate-300 px-2.5 py-1 rounded-md border border-[#243343]"
                >TTS</span
              >
            </div>
          </div>
          <div class="pt-6 mt-6 border-t border-[#243343]">
            <a
              href="https://github.com/DARKAR14/bot-de-twitch-que-hable"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#FF8A4C] text-sm font-semibold hover:text-[#FFA372] flex items-center gap-1.5 group"
            >
              <span>Ver repositorio</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack Técnico -->
    <section id="stack" class="reveal-item space-y-6">
      <div class="flex items-center gap-3">
        <h3 class="text-2xl font-bold font-display text-white">
          Stack Técnico
        </h3>
        <div class="h-px bg-[#243343] flex-grow"></div>
      </div>

      <div
        class="bg-[#17202A] border border-[#243343] p-6 sm:p-8 rounded-2xl shadow-xl"
      >
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {
            [
              { name: "Java", level: "Backend Core" },
              { name: "Spring Boot", level: "Framework" },
              { name: "Spring Security", level: "Seguridad / JWT" },
              { name: "MySQL", level: "Base de datos" },
              { name: "JWT", level: "Autenticación" },
              { name: "Astro", level: "Frontend" },
              { name: "TypeScript", level: "Lenguaje" },
              { name: "Git & GitHub", level: "Control de versiones" },
              { name: "Docker", level: "Contenedores" },
            ].map((tech) => (
              <div class="bg-[#12181F] border border-[#243343] p-4 rounded-xl hover:border-[#FF8A4C]/50 transition-colors group">
                <div class="font-semibold text-white group-hover:text-[#FF8A4C] transition-colors">
                  {tech.name}
                </div>
                <div class="text-xs text-slate-400 mt-1 font-mono">
                  {tech.level}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contact" class="reveal-item space-y-6">
      <div class="flex items-center gap-3">
        <h3 class="text-2xl font-bold font-display text-white">Contacto</h3>
        <div class="h-px bg-[#243343] flex-grow"></div>
      </div>

      <div
        class="bg-[#17202A] border border-[#243343] p-6 sm:p-10 rounded-2xl shadow-xl text-center space-y-6"
      >
        <h4 class="text-xl sm:text-2xl font-bold text-white font-display">
          ¿Interesado en trabajar juntos?
        </h4>
        <p class="text-slate-300 max-w-xl mx-auto text-sm sm:text-base">
          Estoy abierto a nuevas oportunidades como Backend Developer. Si tienes
          un proyecto, vacante o consulta, hablemos.
        </p>

        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a
            href="mailto:malcomgarciaortegon@gmail.com"
            class="bg-[#FF8A4C] text-slate-950 px-6 py-3 rounded-xl font-semibold hover:bg-[#FFA372] transition-all shadow-lg shadow-[#FF8A4C]/20 flex items-center gap-2"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            <span>Enviar correo</span>
          </a>
          <a
            href="https://github.com/NerokxMal"
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[#243343] bg-[#12181F] text-slate-200 px-6 py-3 rounded-xl font-medium hover:border-[#FF8A4C]/60 hover:text-[#FF8A4C] transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path></svg
            >
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer
    class="border-t border-[#243343] py-8 text-center text-xs text-slate-500 font-mono"
  >
    <p>
      © {new Date().getFullYear()} Malcom Camilo García Ortegón. Construido con Astro
      & Tailwind CSS.
    </p>
  </footer>

  <!-- GitHub Floating Badge -->
  <GitHubBadge />

  <!-- Scroll Reveal Intersection Observer Script -->
  <script>
    function initScrollReveal() {
      const revealItems = document.querySelectorAll(".reveal-item");
      if (revealItems.length === 0) return;

      const observer = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: "0px 0px -50px 0px",
        },
      );

      revealItems.forEach((item) => observer.observe(item));
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initScrollReveal);
    } else {
      initScrollReveal();
    }
  </script>
</Layout>
