---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Malcom Camilo García Ortegón — Backend Developer (Java & Spring Boot)",
	description = "Portafolio de Malcom Camilo García Ortegón. Backend Developer enfocado en Java, Spring Boot, microservicios y bases de datos.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#12181F" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Google Fonts optimizado -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>
	</head>
	<body class="bg-[#12181F] text-slate-200 min-h-screen selection:bg-[#FF8A4C] selection:text-slate-950 font-sans antialiased relative">
		<slot />
	</body>
</html>

