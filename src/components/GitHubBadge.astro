---

<div id="github-badge" class="fixed bottom-6 right-6 z-30 hidden sm:flex items-center gap-3 bg-[#17202A]/90 backdrop-blur-md border border-[#243343] px-4 py-2.5 rounded-xl shadow-2xl transition-all duration-300 hover:border-[#FF8A4C]/50 hover:shadow-[0_0_20px_rgba(255,138,76,0.15)] group">
  <div class="relative">
    <img id="gh-avatar" src="https://github.com/NerokxMal.png" alt="NerokxMal" class="w-8 h-8 rounded-full border border-[#243343] group-hover:border-[#FF8A4C] transition-colors" />
    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-[#12181F]"></span>
  </div>
  <div class="text-xs">
    <div class="font-semibold text-slate-200 flex items-center gap-1.5">
      <span>NerokxMal</span>
      <svg class="w-3 h-3 text-[#FF8A4C]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
    </div>
    <div id="gh-stats" class="text-slate-400">Cargando stats...</div>
  </div>
</div>

<script>
  async function fetchGitHubStats() {
    const statsEl = document.getElementById('gh-stats');
    const badgeEl = document.getElementById('github-badge');
    if (!statsEl || !badgeEl) return;

    try {
      const res = await fetch('https://api.github.com/users/NerokxMal', {
        headers: { Accept: 'application/vnd.github.v3+json' }
      });
      if (!res.ok) throw new Error('API limit or error');
      const data = await res.json();
      
      const repos = data.public_repos || 0;
      statsEl.innerHTML = `<span class="text-slate-200 font-medium">${repos}</span> repos públicos`;
      
      // Make whole badge clickable to GitHub profile
      badgeEl.style.cursor = 'pointer';
      badgeEl.addEventListener('click', () => {
        window.open('https://github.com/NerokxMal', '_blank');
      });
    } catch (e) {
      // Fallback silencioso: ocultar badge si hay error o rate limit
      badgeEl.style.display = 'none';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fetchGitHubStats);
  } else {
    fetchGitHubStats();
  }
</script>
